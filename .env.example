# Postgres: своя база docs (pgvector). Роль — только DML; таблицу doc_chunks
# создаёт мигратор (migrations/), расширение vector — init-db.sh wallet-infra.
DATABASE_URL=postgresql://docs:change-me@127.0.0.1:5432/wallet_docs
# Соединений с базой (1–32).
# DB_POOL_SIZE=4

# google-auth — только JWKS (GET /.well-known/jwks.json) для проверки JWT.
AUTH_SERVICE_URL=http://127.0.0.1:8080

# LM Studio (OpenAI-совместимый API). Пусто — вопросы отвечают 503
# llm_unavailable, эмбеддинги не считаются (поиск только полнотекстом).
LLM_URL=http://127.0.0.1:1234/v1
# Чат-модель ответа (≤ 8B Q4 — делит GPU с чатом wallet-ai).
LLM_MODEL=
# Модель эмбеддингов: 768 измерений (vector(768) в миграции). Смена модели —
# новая миграция и полная переиндексация.
EMBED_MODEL=text-embedding-nomic-embed-text-v1.5
# LLM_API_KEY=
# Дедлайн одного вызова LLM, мс.
# LLM_TIMEOUT_MS=120000

# Секрет заливки индекса (заголовок X-Index-Token, Jenkins). Пусто —
# PUT /docs/index/{repo} отвечает 503.
INDEX_TOKEN=

PORT=8089
# 127.0.0.1 — только локально. В контейнере — HOST=0.0.0.0.
HOST=127.0.0.1

# Логи: по умолчанию stdout/stderr, папка — файл на день.
# LOG_DIR=var/log/wallet-docs
# LOG_LEVEL=info
